# ─────────────────────────────────────────────────────────────
# FinalYear Labs — environment variables (copy to .env.local)
# Never commit real values. NEXT_PUBLIC_* values are sent to the browser.
# ─────────────────────────────────────────────────────────────

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=FinalYear Labs
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# Database (server-only). Must be reachable during `next build` (pages prerender from it).
MONGODB_URI=mongodb://localhost:27017/finalyear_labs
MONGODB_DB=
# Optional: only if mongodb+srv:// fails with "querySrv ECONNREFUSED" (local DNS refusing SRV lookups)
MONGODB_DNS_SERVERS=

# Security (server-only) — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=
RATE_LIMIT_SALT=

# Admin bootstrap (only for `npm run create-admin`; remove afterwards)
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_NAME=

# WhatsApp (server-only). International format, digits only or with +/spaces (normalised).
# A missing number falls back to WHATSAPP_DEFAULT_NUMBER. Categories choose a route in the admin panel.
NEXT_PUBLIC_WHATSAPP_ENABLED=true
WHATSAPP_DEFAULT_NUMBER=
WHATSAPP_SALES_NUMBER=
WHATSAPP_AI_NUMBER=
WHATSAPP_WEB_NUMBER=
WHATSAPP_ECOMMERCE_NUMBER=
WHATSAPP_SUPPORT_NUMBER=
WHATSAPP_CUSTOM_NUMBER=

# Track record shown on the site (owner-supplied; keep accurate). 0 hides a stat.
NEXT_PUBLIC_STATS_PROJECTS_COMPLETED=100
NEXT_PUBLIC_STATS_STUDENTS=90
NEXT_PUBLIC_STATS_COLLEGES=30

# Analytics
# GA4 measurement IDs are public by design (they ship in the page), hence NEXT_PUBLIC_.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
ANALYTICS_TZ=Asia/Kolkata
ANALYTICS_RETENTION_DAYS=730

# Images: comma-separated extra hosts allowed by next/image (e.g. your R2 public bucket / CDN)
NEXT_PUBLIC_ASSET_HOSTS=

# Storage (future: presigned uploads to Cloudflare R2 / S3)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Payments (future)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
